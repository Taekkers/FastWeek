g"},{"n":"persille","q":10,"u":"g"}],"kind":"hverdag","minutes":35,"name":"One pot kylling i karry","page":0,"prot":"kylling","rating":0,"rest":true,"url":"https://mummum.dk/one-pot-kylling-i-karry/","tags":["indisk","gryde","ris"]},"ovnbagt-blomkaal-kikaerter":{"book":"Ugekurv","example":false,"ing":[{"n":"blomkål","q":1,"u":"stk"},{"n":"kikærter","q":240,"u":"g"},{"n":"rødløg","q":1,"u":"stk"},{"n":"hvidløg","q":2,"u":"stk"},{"n":"citron","q":1,"u":"stk"},{"n":"græsk yoghurt","q":150,"u":"g"},{"n":"persille","q":10,"u":"g"},{"n":"ris","q":150,"u":"g"}],"kind":"hverdag","minutes":40,"name":"Ovnbagt blomkål med kikærter og yoghurtsauce","page":0,"prot":"vegetar","rating":0,"rest":true,"url":"","method":"Tænd ovnen på 220 grader. Del blomkålen i små buketter, og skær rødløget i både.\nSkyl kikærterne og dup dem tørre.\nVend blomkål, kikærter og løg med 3 spsk olie, 1 tsk spidskommen, 1 tsk paprika, salt og peber på en bageplade med bagepapir.\nBag i 25-30 minutter, til blomkålen er gylden i kanten. Vend det en gang undervejs.\nKog imens risene efter anvisningen på posen.\nRør yoghurten sammen med 1 presset fed hvidløg, saften fra en halv citron, salt og peber.\nServer blomkål og kikærter på ris med yoghurtsauce, hakket persille og citronbåde.","tags":["ovn","mellemøstlig"]},"pasta-cherrytomater-mozzarella":{"book":"Ugekurv","example":false,"ing":[{"n":"pasta","q":200,"u":"g"},{"n":"cherrytomater","q":400,"u":"g"},{"n":"hvidløg","q":3,"u":"stk"},{"n":"mozzarella","q":125,"u":"g"},{"n":"basilikum","q":15,"u":"g"},{"n":"parmesan","q":30,"u":"g"}],"kind":"hverdag","minutes":30,"name":"Pasta med ovnbagte cherrytomater og mozzarella","page":0,"prot":"vegetar","rating":0,"rest":false,"url":"","method":"Tænd ovnen på 200 grader. Læg cherrytomater og hele hvidløgsfed (med skal) i et fad. Vend dem med 3 spsk olie, salt og peber.\nBag i 20 minutter, til tomaterne er sprukne og bløde.\nKog pastaen efter anvisningen, og gem 1 dl af kogevandet.\nMos hvidløgsfeddene ud af skallen, og rør dem sammen med tomaterne i fadet.\nVend pastaen med tomaterne og lidt kogevand, til det bliver til en sauce.\nRids mozzarellaen ud i stykker, og læg den på sammen med basilikum og revet parmesan.","tags":["italiensk","pasta","ovn"]},"pytt-roedbeder-spejlaeg":{"book":"Ugekurv","example":false,"ing":[{"n":"kartofler","q":500,"u":"g"},{"n":"løg","q":1,"u":"stk"},{"n":"rødbeder","q":250,"u":"g"},{"n":"gulerødder","q":100,"u":"g"},{"n":"æg","q":2,"u":"stk"},{"n":"smør","q":20,"u":"g"},{"n":"persille","q":10,"u":"g"}],"kind":"hverdag","minutes":35,"name":"Pytt i panden med rødbeder og spejlæg","page":0,"prot":"aeg","rating":0,"rest":false,"url":"","method":"Skræl kartoflerne og gulerødderne, og skær dem sammen med rødbederne i små tern. Hak løget.\nSteg kartofler og gulerødder i smør og olie på en stor pande i 15 minutter, til de er gyldne og møre. Vend dem ofte.\nTilsæt løg og rødbeder, og steg i 5 minutter mere. Smag til med salt og peber.\nSteg to spejlæg i en anden pande.\nServer pytten med spejlæg, hakket persille og evt. lidt rødbedelage.","tags":["dansk"]},"quesadillas-bonner-majs":{"book":"Ugekurv","example":false,"ing":[{"n":"tortilla","q":4,"u":"stk"},{"n":"kidneybønner","q":240,"u":"g"},{"n":"majs","q":140,"u":"g"},{"n":"peberfrugt","q":1,"u":"stk"},{"n":"cheddar","q":100,"u":"g"},{"n":"salsa","q":100,"u":"g"},{"n":"græsk yoghurt","q":100,"u":"g"},{"n":"lime","q":1,"u":"stk"},{"n":"koriander","q":10,"u":"g"},{"n":"rødløg","q":0.5,"u":"stk"}],"kind":"hverdag","minutes":25,"name":"Quesadillas med bønner, majs og ost","page":0,"prot":"vegetar","rating":0,"rest":false,"url":"","method":"Skyl kidneybønner og majs. Skær peberfrugt og rødløg i små tern, og riv osten.\nSteg peberfrugt og løg i lidt olie i 4 minutter. Tilsæt bønner, majs og halvdelen af salsaen, og varm det igennem.\nFordel fyld og ost på halvdelen af hver tortilla, og fold dem sammen.\nSteg quesadillaerne på en tør pande i 2-3 minutter på hver side, til osten er smeltet, og dejen er gylden.\nRør yoghurt med saft fra en halv lime, salt og hakket koriander.\nSkær i trekanter, og server med resten af salsaen og limeyoghurten.","tags":["mexicansk","wrap"]},"salsiccia-pasta":{"book":"Mummum","example":false,"ing":[{"n":"pasta","q":250,"u":"g"},{"n":"salsiccia","q":150,"u":"g"},{"n":"løg","q":1,"u":"stk"},{"n":"hvidløg","q":2,"u":"stk"},{"n":"hvidvin","q":150,"u":"ml"},{"n":"tomatpuré","q":15,"u":"g"},{"n":"fløde","q":250,"u":"ml"},{"n":"parmesan","q":40,"u":"g"},{"n":"basilikum","q":10,"u":"g"}],"kind":"hverdag","minutes":20,"name":"Salsiccia pasta","page":0,"prot":"svin","rating":0,"rest":true,"url":"https://mummum.dk/salsiccia-pasta/","tags":["italiensk","pasta"]},"shakshuka":{"book":"Ugekurv","example":false,"ing":[{"n":"løg","q":1,"u":"stk"},{"n":"hvidløg","q":2,"u":"stk"},{"n":"peberfrugt","q":1,"u":"stk"},{"n":"hakkede tomater","q":1,"u":"stk"},{"n":"tomatpuré","q":15,"u":"g"},{"n":"æg","q":4,"u":"stk"},{"n":"persille","q":10,"u":"g"},{"n":"naanbrød","q":2,"u":"stk"}],"kind":"hverdag","minutes":30,"name":"Shakshuka med brød","page":0,"prot":"aeg","rating":0,"rest":false,"url":"","method":"Hak løg og hvidløg, og skær peberfrugten i små tern.\nSvits løg og peberfrugt i 2 spsk olie i en bred pande i 5 minutter.\nTilsæt hvidløg, tomatpuré, 1 tsk spidskommen og 1 tsk paprika, og rør i 1 minut.\nHæld de hakkede tomater i, og lad saucen koge ved middel varme i 10 minutter, til den er tyk. Smag til med salt, peber og en knivspids sukker.\nLav fire fordybninger i saucen, og slå et æg i hver. Læg låg på, og lad det stå i 6-8 minutter, til hviderne er stivnet.\nDrys med hakket persille, og server med varmt naanbrød.","tags":["gryde","mellemøstlig"]},"smashed-tacos-kylling":{"book":"Mummum","example":false,"ing":[{"n":"hakket kylling","q":400,"u":"g"},{"n":"tacokrydderi","q":1,"u":"stk"},{"n":"tortilla","q":8,"u":"stk"},{"n":"cherrytomater","q":100,"u":"g"},{"n":"peberfrugt","q":0.5,"u":"stk"},{"n":"rødløg","q":0.5,"u":"stk"},{"n":"avocado","q":1,"u":"stk"},{"n":"majs","q":100,"u":"g"},{"n":"cremefraiche","q":100,"u":"g"},{"n":"koriander","q":7,"u":"g"}],"kind":"hverdag","minutes":25,"name":"Mexi smashed tacos med kylling","page":0,"prot":"kylling","rating":0,"url":"https://mummum.dk/mexi-smashed-tacos-med-kylling/","tags":["mexicansk","wrap"]},"spaghetti-bolognese":{"book":"Mummum","example":false,"ing":[{"n":"løg","q":1,"u":"stk"},{"n":"hvidløg","q":1.5,"u":"stk"},{"n":"basilikum","q":10,"u":"g"},{"n":"hakket oksekød","q":250,"u":"g"},{"n":"tomatpuré","q":35,"u":"g"},{"n":"hakkede tomater","q":0.5,"u":"stk"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"parmesan","q":25,"u":"g"},{"n":"pasta","q":200,"u":"g"}],"kind":"hverdag","minutes":50,"name":"Spaghetti bolognese","page":0,"prot":"okse","rating":0,"rest":true,"url":"https://mummum.dk/spaghetti-bolognese/","tags":["italiensk","pasta"]},"svampepasta-bacon":{"book":"Mummum","example":false,"ing":[{"n":"pasta","q":200,"u":"g"},{"n":"bacon","q":150,"u":"g"},{"n":"hvidløg","q":1.5,"u":"stk"},{"n":"champignon","q":150,"u":"g"},{"n":"æg","q":2,"u":"stk"},{"n":"madlavningsfløde","q":335,"u":"ml"},{"n":"parmesan","q":75,"u":"g"},{"n":"persille","q":6,"u":"g"}],"kind":"hverdag","minutes":20,"name":"Svampepasta med bacon","page":0,"prot":"svin","rating":0,"url":"https://mummum.dk/pasta-med-bacon-og-svampe/","tags":["italiensk","pasta"]},"teriyaki-laks":{"book":"Valdemarsro","example":false,"ing":[{"n":"teriyakisauce","q":25,"u":"ml"},{"n":"soja","q":10,"u":"ml"},{"n":"hvidløg","q":1.5,"u":"stk"},{"n":"ingefær","q":5,"u":"g"},{"n":"laksfilet","q":300,"u":"g"},{"n":"sesamfrø","q":30,"u":"g"},{"n":"gulerødder","q":200,"u":"g"},{"n":"spidskål","q":200,"u":"g"},{"n":"pak choi","q":200,"u":"g"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"rød karrypasta","q":7.5,"u":"g"},{"n":"ris","q":120,"u":"g"},{"n":"lime","q":0.5,"u":"stk"},{"n":"koriander","q":5,"u":"g"}],"kind":"hverdag","minutes":30,"name":"Teriyaki laks med sesam og grønt","page":0,"prot":"fisk","rating":0,"url":"https://www.v