,{"n":"græsk yoghurt","q":50,"u":"g"},{"n":"koriander","q":7.5,"u":"g"},{"n":"citron","q":0.5,"u":"stk"}],"kind":"hverdag","minutes":45,"name":"Linsekarry med ris","page":0,"prot":"vegetar","rating":0,"rest":true,"url":"https://www.valdemarsro.dk/linsekarry-med-ris/","tags":["indisk","gryde","ris"]},"linsesuppe-rugbroed":{"book":"Mummum","example":false,"ing":[{"n":"løg","q":1,"u":"stk"},{"n":"hvidløg","q":1.5,"u":"stk"},{"n":"blomkål","q":0.5,"u":"stk"},{"n":"gulerødder","q":200,"u":"g"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"røde linser","q":40,"u":"g"},{"n":"tomatpuré","q":15,"u":"g"},{"n":"kokosmælk","q":50,"u":"ml"},{"n":"rugbrød","q":2,"u":"stk"},{"n":"cremefraiche","q":20,"u":"g"},{"n":"persille","q":4,"u":"g"}],"kind":"hverdag","minutes":35,"name":"Linsesuppe med rugbrødscroutoner","page":0,"prot":"vegetar","rating":0,"rest":true,"url":"https://mummum.dk/linsesuppe-med-rugbroedscroutoner/","tags":["suppe","dansk"]},"majs-squashfritter":{"book":"Ugekurv","example":false,"ing":[{"n":"squash","q":300,"u":"g"},{"n":"majs","q":140,"u":"g"},{"n":"æg","q":2,"u":"stk"},{"n":"mel","q":80,"u":"g"},{"n":"græsk yoghurt","q":150,"u":"g"},{"n":"citron","q":1,"u":"stk"},{"n":"dild","q":10,"u":"g"},{"n":"rødløg","q":0.5,"u":"stk"},{"n":"blandet salat","q":60,"u":"g"}],"kind":"hverdag","minutes":30,"name":"Majs- og squashfritter med yoghurtdip","page":0,"prot":"vegetar","rating":0,"rest":false,"url":"","method":"Riv squashen groft, og tryk vandet ud i et rent viskestykke. Hak rødløget fint.\nPisk æg og mel sammen med salt og peber. Vend squash, majs og løg i.\nSteg små fritter i olie på en pande ved middel varme i 3 minutter på hver side, til de er gyldne. Kom dem på køkkenrulle.\nRør yoghurten med saft fra en halv citron, hakket dild, salt og peber.\nServer fritterne med yoghurtdip, blandet salat og citronbåde.","tags":["dansk"]},"marry-me-chicken":{"book":"Valdemarsro","example":false,"ing":[{"n":"kyllingebryst","q":300,"u":"g"},{"n":"mel","q":15,"u":"g"},{"n":"lø