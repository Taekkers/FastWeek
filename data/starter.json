{"asiatisk-kyllingesalat":{"book":"Valdemarsro","example":false,"ing":[{"n":"kyllingebryst","q":340,"u":"g"},{"n":"blandet salat","q":125,"u":"g"},{"n":"rødløg","q":1,"u":"stk"},{"n":"rucola","q":20,"u":"g"},{"n":"mynte","q":10,"u":"g"},{"n":"koriander","q":5,"u":"g"},{"n":"rød chili","q":0.5,"u":"stk"},{"n":"sesamfrø","q":30,"u":"g"},{"n":"fishsauce","q":30,"u":"ml"},{"n":"lime","q":1,"u":"stk"},{"n":"sukker","q":4,"u":"g"},{"n":"ingefær","q":15,"u":"g"},{"n":"hvidløg","q":1.5,"u":"stk"}],"kind":"hverdag","minutes":40,"name":"Asiatisk kyllingesalat","page":0,"prot":"kylling","rating":0,"rest":false,"url":"https://www.valdemarsro.dk/asiatisk-kyllingesalat/","tags":["asiatisk","salat"]},"bagt-kylling":{"book":"Valdemarsro","example":false,"ing":[{"n":"hel kylling","q":500,"u":"g"},{"n":"kartofler","q":400,"u":"g"},{"n":"gulerødder","q":200,"u":"g"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"smør","q":7.5,"u":"g"}],"kind":"weekend","minutes":60,"name":"Bagt kylling med kartofler og krydderurter","page":0,"prot":"kylling","rating":0,"url":"https://www.valdemarsro.dk/bagt-kylling/","tags":["ovn","dansk"]},"boller-i-karry":{"book":"Valdemarsro","example":false,"ing":[{"n":"hakket svine- og kalvekød","q":200,"u":"g"},{"n":"løg","q":0.5,"u":"stk"},{"n":"mælk","q":175,"u":"ml"},{"n":"æg","q":0.5,"u":"stk"},{"n":"havregryn","q":20,"u":"g"},{"n":"smør","q":15,"u":"g"},{"n":"mel","q":15,"u":"g"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"ris","q":150,"u":"g"},{"n":"æble","q":0.5,"u":"stk"},{"n":"mango","q":0.5,"u":"stk"},{"n":"persille","q":7.5,"u":"g"}],"kind":"hverdag","minutes":35,"name":"Boller i karry","page":0,"prot":"svin","rating":0,"rest":true,"url":"https://www.valdemarsro.dk/boller-i-karry/","tags":["dansk","gryde"]},"chili-con-carne-ris":{"book":"Ugekurv","example":false,"ing":[{"n":"hakket oksekød","q":300,"u":"g"},{"n":"løg","q":1,"u":"stk"},{"n":"hvidløg","q":2,"u":"stk"},{"n":"peberfrugt","q":1,"u":"stk"},{"n":"kidneybønner","q":240,"u":"g"},{"n":"hakkede tomater","q":2,"u":"stk"},{"n":"tomatpuré","q":30,"u":"g"},{"n":"majs","q":100,"u":"g"},{"n":"ris","q":150,"u":"g"},{"n":"tacokrydderi","q":1,"u":"stk"},{"n":"cremefraiche","q":100,"u":"g"},{"n":"lime","q":1,"u":"stk"}],"kind":"hverdag","minutes":50,"name":"Chili con carne med ris","page":0,"prot":"okse","rating":0,"rest":true,"url":"","method":"Hak løg og hvidløg, og skær peberfrugten i tern.\nBrun kødet i en gryde ved høj varme i 5 minutter. Tilsæt løg, peberfrugt og hvidløg, og steg i 3 minutter.\nRør tomatpuré og tacokrydderi i, og steg i 1 minut.\nTilsæt hakkede tomater, skyllede kidneybønner og majs. Lad det simre under låg i 25-30 minutter. Rør af og til, og tilsæt lidt vand, hvis det bliver for tykt.\nKog risene efter anvisningen.\nSmag chilien til med salt, peber og limesaft, og server med ris og en klat cremefraiche.","tags":["mexicansk","gryde","ris"]},"enchiladas-kylling":{"book":"Mummum","example":false,"ing":[{"n":"hvidløg","q":1,"u":"stk"},{"n":"løg","q":0.5,"u":"stk"},{"n":"kyllingebryst","q":200,"u":"g"},{"n":"gulerødder","q":50,"u":"g"},{"n":"peberfrugt","q":0.5,"u":"stk"},{"n":"tacokrydderi","q":0.5,"u":"stk"},{"n":"kidneybønner","q":100,"u":"g"},{"n":"majs","q":70,"u":"g"},{"n":"hakkede tomater","q":0.5,"u":"stk"},{"n":"tortilla","q":4,"u":"stk"},{"n":"cheddar","q":100,"u":"g"},{"n":"avocado","q":1,"u":"stk"},{"n":"salsa","q":50,"u":"g"},{"n":"cremefraiche","q":50,"u":"g"},{"n":"jalapenos","q":25,"u":"g"},{"n":"koriander","q":7.5,"u":"g"}],"kind":"weekend","minutes":40,"name":"Enchiladas med kylling","page":0,"prot":"kylling","rating":0,"rest":true,"url":"https://mummum.dk/enchiladas-med-kylling/","tags":["mexicansk","ovn","wrap"]},"frikadeller-agurkesalat":{"book":"Ugekurv","example":false,"ing":[{"n":"hakket svine- og kalvekød","q":400,"u":"g"},{"n":"løg","q":1,"u":"stk"},{"n":"æg","q":1,"u":"stk"},{"n":"mel","q":30,"u":"g"},{"n":"mælk","q":100,"u":"ml"},{"n":"kartofler","q":600,"u":"g"},{"n":"agurk","q":1,"u":"stk"},{"n":"smør","q":20,"u":"g"},{"n":"persille","q":10,"u":"g"}],"kind":"hverdag","minutes":50,"name":"Frikadeller med kartofler og agurkesalat","page":0,"prot":"svin","rating":0,"rest":true,"url":"","method":"Skræl kartoflerne, og kog dem i letsaltet vand i 20 minutter.\nRiv løget fint. Ælt farsen med løg, æg, mel, mælk, 1 tsk salt og peber, til den er luftig. Lad den hvile i 10 minutter.\nForm frikadeller med en våd ske, og steg dem i smør og olie ved middel varme i 4-5 minutter på hver side, til de er gennemstegte.\nSkær agurken i tynde skiver, og rør dem med 2 spsk eddike, 1 spsk sukker, salt, peber og persille. Lad dem trække.\nServer frikadellerne med kartofler og agurkesalat.","tags":["dansk"]},"groentsagsgryde-kikaerter":{"book":"Valdemarsro","example":false,"ing":[{"n":"rødløg","q":0.5,"u":"stk"},{"n":"hvidløg","q":1,"u":"stk"},{"n":"butternut squash","q":200,"u":"g"},{"n":"gulerødder","q":200,"u":"g"},{"n":"hakkede tomater","q":1,"u":"stk"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"broccoli","q":175,"u":"g"},{"n":"squash","q":150,"u":"g"},{"n":"kikærter","q":120,"u":"g"},{"n":"citron","q":0.5,"u":"stk"},{"n":"cremefraiche","q":50,"u":"g"},{"n":"persille","q":7.5,"u":"g"},{"n":"ris","q":130,"u":"g"}],"kind":"hverdag","minutes":30,"name":"Grøntsagsgryde med kikærter","page":0,"prot":"vegetar","rating":0,"rest":true,"url":"https://www.valdemarsro.dk/groentsagsgryde-med-kikaerter/","tags":["gryde","mellemøstlig"]},"groentslasagne-spinat":{"book":"Ugekurv","example":false,"ing":[{"n":"lasagneplader","q":125,"u":"g"},{"n":"løg","q":1,"u":"stk"},{"n":"hvidløg","q":2,"u":"stk"},{"n":"squash","q":300,"u":"g"},{"n":"champignon","q":200,"u":"g"},{"n":"spinat","q":150,"u":"g"},{"n":"hakkede tomater","q":2,"u":"stk"},{"n":"tomatpuré","q":30,"u":"g"},{"n":"smør","q":30,"u":"g"},{"n":"mel","q":30,"u":"g"},{"n":"mælk","q":400,"u":"ml"},{"n":"mozzarella","q":125,"u":"g"},{"n":"parmesan","q":30,"u":"g"},{"n":"basilikum","q":10,"u":"g"}],"kind":"weekend","minutes":80,"name":"Grøntsagslasagne med spinat og mozzarella","page":0,"prot":"vegetar","rating":0,"rest":true,"url":"","method":"Tænd ovnen på 200 grader. Hak løg og hvidløg, og skær squash og champignon i tern.\nSvits løg, squash og champignon i olie i 8 minutter. Tilsæt hvidløg og tomatpuré, og rør i 1 minut.\nHæld de hakkede tomater i, og lad det simre i 10 minutter. Rør spinaten i, til den er faldet sammen. Smag til med salt og peber.\nLav hvid sauce: smelt smørret, rør melet i, og pisk mælken i lidt ad gangen. Lad saucen koge i 4-5 minutter, og smag til med salt og lidt muskat.\nLæg lag i et ildfast fad: grøntsagssauce, lasagneplader og hvid sauce. Gentag, og slut med hvid sauce.\nFordel revet mozzarella og parmesan øverst, og bag i 35-40 minutter, til toppen er gylden.\nLad lasagnen hvile 10 minutter, og drys med basilikum.","tags":["italiensk","pasta","ovn"]},"indisk-dahl":{"book":"Mummum","example":false,"ing":[{"n":"hvidløg","q":2,"u":"stk"},{"n":"løg","q":1,"u":"stk"},{"n":"gulerødder","q":125,"u":"g"},{"n":"ingefær","q":10,"u":"g"},{"n":"røde linser","q":100,"u":"g"},{"n":"kokosmælk","q":200,"u":"ml"},{"n":"hakkede tomater","q":0.5,"u":"stk"},{"n":"cremefraiche","q":100,"u":"g"},{"n":"saltmandler","q":30,"u":"g"},{"n":"persille","q":3.5,"u":"g"},{"n":"naanbrød","q":2,"u":"stk"}],"kind":"hverdag","minutes":50,"name":"Indisk dahl","page":0,"prot":"vegetar","rating":0,"rest":true,"url":"https://mummum.dk/indisk-dahl/","tags":["indisk","gryde"]},"kaalfad-oksekoed":{"book":"Valdemarsro","example":false,"ing":[{"n":"hakket oksekød","q":200,"u":"g"},{"n":"løg","q":0.5,"u":"stk"},{"n":"hvidløg","q":1.5,"u":"stk"},{"n":"gulerødder","q":150,"u":"g"},{"n":"squash","q":100,"u":"g"},{"n":"spidskål","q":200,"u":"g"},{"n":"fløde","q":50,"u":"ml"},{"n":"bouillonterning","q":0.5,"u":"stk"},{"n":"cheddar","q":50,"u":"g"},{"n":"persille","q":7.5,"u":"g"},{"n":"sesamfrø","q":5,"u":"g"}],"kind":"hverdag","minutes":45,"name":"Kålfad med hakket oksekød og grøntsager","page":0,"prot":"okse","rating":0,"rest":true,"